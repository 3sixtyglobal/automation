					}
				],
				"security": [
					{
						"jwtBearerAuthScheme": []
					}
				],
				"requestBody": {
					"description": "Request to trigger an automation action.",
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/AutomationTriggerRequest"
							},
							"examples": {
								"AutomationTriggerRequestExample": {
									"value": {
