	"packages": {
		"packages/automation-models": {
			"package-name": "automation-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/automation-service": {
			"package-name": "automation-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/automation-rest-client": {
			"package-name": "automation-rest-client",
			"changelog-path": "docs/changelog.md"
		},
		"packages/automation-actions": {
			"package-name": "automation-actions",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
